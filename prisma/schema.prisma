generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username              String            @unique
  email                 String            @unique
  firstName             String?
  lastName              String?
  displayName           String?
  clerkid               String            @unique
  image                 String?
  bio                   String?
  location              String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  closet                Closet?
  favorites             Favorite[]        @relation("UserFavorites")
  listings              Listing[]
  messagesFrom          Message[]         @relation("MessageFrom")
  messagesTo            Message[]         @relation("MessageTo")
  reviewsReceived       Review[]          @relation("ReviewTo")
  reviewsGiven          Review[]          @relation("ReviewFrom")
  TradePreference       TradePreference[]
  tradeRequestsSent     TradeRequest[]    @relation("TradeFrom")
  tradeRequestsReceived TradeRequest[]    @relation("TradeTo")
  blockedUsers          BlockedUser[]     @relation("UserBlocking")
  blockedByUsers        BlockedUser[]     @relation("UserBlocked")
}

model Closet {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @default("My Closet")
  userId    String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  listings  Listing[]
}

model Listing {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                  String
  description            String
  imageUrls              String[]
  isPrivate              Boolean           @default(false)
  order                  Int               @default(0)
  userId                 String            @db.Uuid
  closetId               String            @db.Uuid
  status                 ListingStatus     @default(ACTIVE)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  favorites              Favorite[]        @relation("ListingFavorites")
  closet                 Closet            @relation(fields: [closetId], references: [id])
  user                   User              @relation(fields: [userId], references: [id])
  messages               Message[]
  reviews                Review[]
  tradePreferences       TradePreference[]
  tradeRequestsInitiated TradeRequest[]    @relation("InitiatorListings")
  tags                   Tag[]             @relation("ListingTags")
  tradeRequestsReceived  TradeRequest[]    @relation("TargetListings")
}

model TradePreference {
  id        String   @id @default(cuid())
  listingId String   @db.Uuid
  userId    String   @db.Uuid
  title     String
  imageUrl  String
  notes     String?
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model TradeRequest {
  id                String      @id @default(cuid())
  fromUserId        String      @db.Uuid
  toUserId          String      @db.Uuid
  status            TradeStatus @default(PENDING)
  message           String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  fromUser          User        @relation("TradeFrom", fields: [fromUserId], references: [id])
  toUser            User        @relation("TradeTo", fields: [toUserId], references: [id])
  initiatorListings Listing[]   @relation("InitiatorListings")
  targetListings    Listing[]   @relation("TargetListings")
  reviews           Review[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  listings Listing[] @relation("ListingTags")
}

model Favorite {
  id        String  @id @default(cuid())
  userId    String  @db.Uuid
  listingId String  @db.Uuid
  listing   Listing @relation("ListingFavorites", fields: [listingId], references: [id])
  user      User    @relation("UserFavorites", fields: [userId], references: [id])

  @@unique([userId, listingId])
}

model Message {
  id        String    @id @default(cuid())
  fromId    String    @db.Uuid
  toId      String    @db.Uuid
  content   String
  listingId String?   @db.Uuid
  timestamp DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isRead    Boolean   @default(false)
  readAt    DateTime?
  from      User      @relation("MessageFrom", fields: [fromId], references: [id])
  listing   Listing?  @relation(fields: [listingId], references: [id])
  to        User      @relation("MessageTo", fields: [toId], references: [id])
}

model Review {
  id         String        @id @default(cuid())
  rating     Int
  comment    String?
  reviewerId String        @db.Uuid
  revieweeId String        @db.Uuid
  listingId  String?       @db.Uuid
  tradeId    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  listing    Listing?      @relation(fields: [listingId], references: [id])
  reviewee   User          @relation("ReviewTo", fields: [revieweeId], references: [id])
  reviewer   User          @relation("ReviewFrom", fields: [reviewerId], references: [id])
  trade      TradeRequest? @relation(fields: [tradeId], references: [id])

  @@unique([reviewerId, tradeId])
}

model BlockedUser {
  id          String   @id @default(cuid())
  blockerId   String   @db.Uuid
  blockedId   String   @db.Uuid
  createdAt   DateTime @default(now())
  blocker     User     @relation("UserBlocking", fields: [blockerId], references: [id])
  blocked     User     @relation("UserBlocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

enum ListingStatus {
  ACTIVE
  SOLD
  ARCHIVED
}
